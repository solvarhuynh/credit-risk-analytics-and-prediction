.ipynb_checkpoints/
*/.ipynb_checkpoints/*

# 6. Cau hinh IDE / Editor
.vscode/
.idea/
*.sublime-project
*.sublime-workspace

# 7. He dieu hanh & Tep tam
.DS_Store
Thumbs.db
desktop.ini
*.tmp
*.temp
~$*.docx
~$*.xlsx
~$*.pptx

