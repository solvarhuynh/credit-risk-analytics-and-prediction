	column pd_bin_label =
			
			VAR LowVal = FLOOR('fact_evaluated_loan'[predicted_pd], 0.05)
			VAR HighVal = LowVal + 0.05
			RETURN
			FORMAT(LowVal, "0.00") & "–<" & FORMAT(HighVal, "0.00")
		lineageTag: 3f46fc84-da8d-411a-9ba8-49d234b9e1ed
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

	column fico_band =
			
			SWITCH(
			    TRUE(),
			    'fact_evaluated_loan'[fico_avg] >= 750, "750+",
			    'fact_evaluated_loan'[fico_avg] >= 700, "700-749",
			    "650-699"
			)
		lineageTag: bf0c4148-e3b4-410b-bf98-476e542ff16a
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

	column lti_bin =
			
			VAR _ratio = DIVIDE('fact_evaluated_loan'[loan_amnt], 'fact_evaluated_loan'[annual_inc])
			RETURN
			SWITCH(
			    TRUE(),
			    ISBLANK(_ratio), BLANK(),
			    _ratio < 0.1, "<0.1",
			    _ratio < 0.2, "0.1–0.2",
			    _ratio < 0.3, "0.2–0.3",
			    _ratio < 0.4, "0.3–0.4",
			    _ratio < 0.5, "0.4–0.5",
			    _ratio < 0.6, "0.5–0.6",
			    _ratio < 0.7, "0.6–0.7",
			    ">0.7"
			)
		lineageTag: 39c30593-b6f3-4ee9-8f49-de4cf7367576
		summarizeBy: none
		sortByColumn: lti_bin_sort

		changedProperty = SortByColumn

		annotation SummarizationSetBy = Automatic

	column lti_bin_sort =
			
			VAR _ratio = DIVIDE('fact_evaluated_loan'[loan_amnt], 'fact_evaluated_loan'[annual_inc])
			RETURN
			SWITCH(
			    TRUE(),
			    ISBLANK(_ratio), BLANK(),
			    _ratio < 0.1, 1,
			    _ratio < 0.2, 2,
			    _ratio < 0.3, 3,
			    _ratio < 0.4, 4,
			    _ratio < 0.5, 5,
			    _ratio < 0.6, 6,
			    _ratio < 0.7, 7,
			    8
			)
		formatString: 0
		lineageTag: 70de1f08-f34e-4c4b-a1cb-99a6e8d35a63
		summarizeBy: sum

		annotation SummarizationSetBy = Automatic

	column Tier = MID('fact_evaluated_loan'[risk_tier], 6, 1)
		lineageTag: 28582d9e-1b4a-4f4f-a5f8-43ec0b503bd4
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

	partition fact_evaluated_loan = m
		mode: import
		source =
