table fact_evaluated_loan
	lineageTag: 0fbf6855-79e0-4833-b57b-812b4f83b746

	measure 'Evaluated Loan Count' = COUNTROWS('fact_evaluated_loan')
		formatString: 0
		lineageTag: 23064a20-3c0a-4efe-9e8a-600340af0dfb

	measure 'Mean PD' = AVERAGE('fact_evaluated_loan'[predicted_pd])
		formatString: 0.00%;-0.00%;0.00%
		lineageTag: b54eaeef-614f-45c9-8fc2-e5e3f0d28db7

	measure 'Total Expected Loss' = SUM('fact_evaluated_loan'[expected_loss])
		lineageTag: 71dd4fe6-abef-457b-be2d-c0f1a7d79942

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'PD Bin Count' = COUNTROWS('fact_evaluated_loan')
		formatString: 0
		lineageTag: 59861d8a-399e-426b-8123-54e76e17fa58

	measure 'PD Bin Share' =
			
			DIVIDE(
			    COUNTROWS('fact_evaluated_loan'),
			    CALCULATE(COUNTROWS('fact_evaluated_loan'), ALLSELECTED('fact_evaluated_loan'))
			)
		lineageTag: 9d222206-6236-440d-bdcb-27928a3d2d03

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Total EAD Proxy' = SUM('fact_evaluated_loan'[ead_proxy])
		lineageTag: 06ef8de2-396d-45a8-8eeb-c15a554a1d73

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'EL Contribution %' =
			
			DIVIDE(
			    [Total Expected Loss],
			    CALCULATE([Total Expected Loss], ALLSELECTED('fact_evaluated_loan'))
			)
		lineageTag: 328c0f29-40df-4daf-ad6b-6a83d6f82364

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Observed Default Rate Test' = AVERAGE('fact_evaluated_loan'[target])
		formatString: 0.00%;-0.00%;0.00%
		lineageTag: 2352cc68-b4e2-4fd7-826c-c3ba8a5a2597

	measure 'Risk Tier Share' =
			
			DIVIDE(
			    COUNTROWS('fact_evaluated_loan'),
			    CALCULATE(COUNTROWS('fact_evaluated_loan'), ALLSELECTED('fact_evaluated_loan'))
			)
		formatString: 0.00%;-0.00%;0.00%
		lineageTag: 59187f19-7224-4efb-807c-e7ebc69ce63b

