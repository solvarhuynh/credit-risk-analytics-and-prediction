				    Source = Parquet.Document(File.Contents("D:\Huy\HCMUTE\Nam3\D1\TTDL\DACK\credit-risk-analytics-and-prediction\data\processed\cleaned_dataset.parquet"), [Compression=null, LegacyColumnNameEncoding=false, MaxDepth=null])
				in
