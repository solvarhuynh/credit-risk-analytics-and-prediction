		sourceColumn: dti_band
		sortByColumn: dti_band_sort

		changedProperty = SortByColumn

		annotation SummarizationSetBy = Automatic

	column dti_band_sort =
			
			SWITCH(
			    TRUE(),
			    cleaned_dataset[dti] <= 10, 1,
			    cleaned_dataset[dti] <= 20, 2,
			    cleaned_dataset[dti] <= 30, 3,
			    cleaned_dataset[dti] > 30, 4,
			    5
			)
		formatString: 0
		lineageTag: e36a47e4-ef76-4739-96d6-5fe793495420
		summarizeBy: sum

		annotation SummarizationSetBy = Automatic

	column income_band_sort =
			
			SWITCH(
			    TRUE(),
			    cleaned_dataset[annual_inc] <= 40000, 1,
			    cleaned_dataset[annual_inc] <= 80000, 2,
			    cleaned_dataset[annual_inc] <= 150000, 3,
			    4
			)
		formatString: 0
		lineageTag: 479fdbd2-0507-428f-a4c7-055ce36f46bd
		summarizeBy: sum

		annotation SummarizationSetBy = Automatic

	column lti_bin =
			
			SWITCH(
			    TRUE(),
			    ISBLANK('cleaned_dataset'[loan_to_income_ratio]), BLANK(),
			    'cleaned_dataset'[loan_to_income_ratio] < 0.1, "<0.1",
			    'cleaned_dataset'[loan_to_income_ratio] < 0.2, "0.1–0.2",
			    'cleaned_dataset'[loan_to_income_ratio] < 0.3, "0.2–0.3",
			    'cleaned_dataset'[loan_to_income_ratio] < 0.4, "0.3–0.4",
			    'cleaned_dataset'[loan_to_income_ratio] < 0.5, "0.4–0.5",
			    'cleaned_dataset'[loan_to_income_ratio] < 0.6, "0.5–0.6",
			    'cleaned_dataset'[loan_to_income_ratio] < 0.7, "0.6–0.7",
			    ">0.7"
			)
		lineageTag: 1fe63a11-8ea9-410a-b2f5-a6b1743916c0
		summarizeBy: none
		sortByColumn: lti_bin_sort

		changedProperty = SortByColumn

		annotation SummarizationSetBy = Automatic

	column lti_bin_sort =
			
			SWITCH(
			    TRUE(),
			    ISBLANK('cleaned_dataset'[loan_to_income_ratio]), BLANK(),
			    'cleaned_dataset'[loan_to_income_ratio] < 0.1, 1,
			    'cleaned_dataset'[loan_to_income_ratio] < 0.2, 2,
			    'cleaned_dataset'[loan_to_income_ratio] < 0.3, 3,
			    'cleaned_dataset'[loan_to_income_ratio] < 0.4, 4,
			    'cleaned_dataset'[loan_to_income_ratio] < 0.5, 5,
			    'cleaned_dataset'[loan_to_income_ratio] < 0.6, 6,
			    'cleaned_dataset'[loan_to_income_ratio] < 0.7, 7,
			    8
			)
		formatString: 0
		lineageTag: 95b44c88-1c42-4767-b9fa-a9dd3c5c5049
		summarizeBy: sum

		annotation SummarizationSetBy = Automatic

	partition cleaned_dataset = m
		mode: import
		source =
