table cleaned_dataset
	lineageTag: 388227b7-895b-4bd7-a473-21b8050e5316

	measure Measure
		lineageTag: e0b8d833-00a5-4dcf-b3f8-e2107a030184

		annotation 43dbc3e8-3a1c-4b6f-9923-b49ff7d6691c = True

	measure 'Total Loans' = COUNTROWS(cleaned_dataset)
		formatString: 0
		lineageTag: 14bedcc7-4783-4d7f-b6c0-792823578148

	measure 'Observed Default Rate — Portfolio' =

			VAR TotalCount = COUNTROWS(cleaned_dataset)
			VAR DefaultCount = CALCULATE(COUNTROWS(cleaned_dataset), cleaned_dataset[target] = 1)
			RETURN
			IF(
			    TotalCount >= 100,
			    DIVIDE(DefaultCount, TotalCount),
			    BLANK()
			)
		formatString: 0.0%;-0.0%;0.0%
		lineageTag: cd21f44e-9bbf-421d-9416-858d938ad08f

	measure 'Total Funded Amount' = SUM(cleaned_dataset[loan_amnt])
		formatString: #,0.00;(#,0.00);#,0.00
		lineageTag: fb604a24-b802-4c2b-bd8f-8f193b3398ec

	measure 'Average FICO Score' = AVERAGE(cleaned_dataset[fico_avg])
		formatString: 0
		lineageTag: 2704b96f-4a20-49ff-b382-a21c7f40ad40

	measure 'Average Loan Amount' = AVERAGE(cleaned_dataset[loan_amnt])
		formatString: #,0.##;(#,0.##);#,0.##
		lineageTag: 32add578-679b-4f34-8bd6-00cde6cc32aa

	measure 'Top Purpose' =
			VAR PurposeCounts = ADDCOLUMNS(ALLSELECTED(cleaned_dataset[purpose]), "LoanCount", [Total Loans])
			RETURN MAXX(TOPN(1, PurposeCounts, [LoanCount], DESC, cleaned_dataset[purpose], ASC), cleaned_dataset[purpose])
		lineageTag: 6f92f7d8-f98b-45c7-aec1-4902df6f65e3

	measure 'Peak Year' =
			VAR YearCounts = ADDCOLUMNS(ALLSELECTED(dim_date[year]), "LoanCount", [Total Loans])
			RETURN MAXX(TOPN(1, YearCounts, [LoanCount], DESC, dim_date[year], ASC), dim_date[year])
		formatString: 0
		lineageTag: dc2430b8-a004-47c7-bfe1-5f0204cbf08d

	measure 'Label Peak Year' = IF(SELECTEDVALUE(dim_date[year]) = [Peak Year], FORMAT([Total Loans], "#,0") & " (Peak)", BLANK())
		lineageTag: 3b8038d7-ea23-4e22-9716-2ed88d249786

	measure 'Average Annual Income' = AVERAGE(cleaned_dataset[annual_inc])
		formatString: #,0.##;(#,0.##);#,0.##
		lineageTag: 17fb612f-99d2-4a11-b5ee-27141190ed40

