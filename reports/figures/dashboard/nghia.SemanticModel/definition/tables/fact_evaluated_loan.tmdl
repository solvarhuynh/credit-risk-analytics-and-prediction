	column 'PD Bin Label Short' =

			SWITCH(
			    fact_evaluated_loan[pd_bin],
			    1, "0 - 5%",
			    2, "5 - 10%",
			    3, "10 - 15%",
			    4, "15 - 20%",
			    5, "20 - 25%",
			    6, "25 - 30%",
			    7, "30 - 35%",
			    8, "35 - 40%",
			    9, "40 - 45%",
			    10, "45 - 50%",
			    11, "50 - 55%",
			    12, "55 - 60%",
			    13, "60 - 65%",
			    14, "65 - 70%",
			    15, "70 - 75%",
			    16, "75 - 80%",
			    17, "80 - 85%",
			    18, "85 - 90%",
			    19, "90 - 95%",
			    20, "95 - 100%",
			    "Khác"
			)
		lineageTag: 7b98db12-7a32-49b9-ba0e-1f5e5c35e75c
