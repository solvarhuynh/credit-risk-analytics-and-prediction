table fact_evaluated_loan
	lineageTag: b5d51af8-1bba-4027-953b-3707038b34cf

	/// Số evaluated frozen-test loans trong ngữ cảnh lọc.
	measure 'Evaluated Loan Count' = COUNTROWS('fact_evaluated_loan')
		formatString: #,0
		lineageTag: 689a4768-b084-4ef7-a4c3-9dddf951f3b6

	/// Trung bình predicted PD; không phải observed default rate.
	measure 'Mean PD' = AVERAGE('fact_evaluated_loan'[predicted_pd])
		formatString: 0.00%
		lineageTag: 034214e6-a4fd-4180-89ec-6f514273c60b

	/// Số observed target=1 trong evaluated population.
	measure 'Observed Default Count' = CALCULATE(COUNTROWS('fact_evaluated_loan'), 'fact_evaluated_loan'[target] = 1)
		formatString: #,0
		lineageTag: 3cd9ed60-d1ab-4a72-8128-db17a56011a8

	/// Observed target=1 chia evaluated loan count.
	measure 'Observed Default Rate' = DIVIDE([Observed Default Count], [Evaluated Loan Count])
		formatString: 0.00%
		lineageTag: 66e96b5c-8632-4604-acda-96eb00dc5391

	/// Tỷ trọng loan trong tổng evaluated population theo tier; loại bỏ cả label và sort key filter.
	measure 'Risk Tier Share' = DIVIDE([Evaluated Loan Count], CALCULATE([Evaluated Loan Count], ALL('fact_evaluated_loan'[risk_tier], 'fact_evaluated_loan'[tier_sort_order])))
		formatString: 0.00%
		lineageTag: a9fef787-e06c-48d4-8394-4415ce5a0246

	/// Số evaluated loans trong PD bin.
	measure 'PD Bin Count' = [Evaluated Loan Count]
		formatString: #,0
		lineageTag: 69eb614b-4e51-49b4-a1a2-27fb9425b9ee

	/// Tỷ trọng evaluated loans trong PD bin.
	measure 'PD Bin Share' = DIVIDE([PD Bin Count], CALCULATE([Evaluated Loan Count], ALL('fact_evaluated_loan'[pd_bin_label], 'fact_evaluated_loan'[pd_bin_sort_order], 'fact_evaluated_loan'[pd_bin])))
		formatString: 0.00%
		lineageTag: 097b1418-a4a6-4383-96ba-62bb1ecefab7

	/// Tổng Expected Loss giả định LGD 45%, từ giá trị canonical đã lưu; đơn vị nguồn.
	measure 'Total Expected Loss' = SUM('fact_evaluated_loan'[expected_loss_lgd_45])
		formatString: #,0.00
		lineageTag: 54088be0-c93b-4096-8219-31354e1d649c

	/// Tỷ trọng Expected Loss của tier trong evaluated population hiện được lọc.
	measure 'EL Contribution %' = DIVIDE([Total Expected Loss], CALCULATE([Total Expected Loss], ALL('fact_evaluated_loan'[risk_tier], 'fact_evaluated_loan'[tier_sort_order])))
		formatString: 0.00%
		lineageTag: 03821fe1-5e1f-430a-aa3b-0b08453cbaed

	/// Tổng EAD proxy từ loan amount tại thời điểm khoản vay được cấp.
	measure 'Total EAD Proxy' = SUM('fact_evaluated_loan'[ead_proxy])
		formatString: #,0
		lineageTag: eb1f3b9f-3c09-4804-bd39-d26df1ab9138

	/// Median PD trong FICO band hoặc ngữ cảnh lọc hiện hành.
	measure 'Median PD' = MEDIAN('fact_evaluated_loan'[predicted_pd])
		formatString: 0.00%
		lineageTag: 3f460b1b-37b0-4e18-8aae-9d4411caaaa8

	/// Phân vị thứ 25 của predicted PD trong ngữ cảnh lọc hiện hành.
	measure 'PD Q1' = PERCENTILEX.INC('fact_evaluated_loan', 'fact_evaluated_loan'[predicted_pd], 0.25)
		formatString: 0.00%
		lineageTag: 3c787f9b-aa9a-4530-bb9f-aaeeda432958

	/// Phân vị thứ 75 của predicted PD trong ngữ cảnh lọc hiện hành.
	measure 'PD Q3' = PERCENTILEX.INC('fact_evaluated_loan', 'fact_evaluated_loan'[predicted_pd], 0.75)
		formatString: 0.00%
		lineageTag: 5ac70baf-350f-424e-8a33-4308d399f4e5

	/// Số default dùng riêng cho V01; nhóm có zero default phải hiển thị 0 thay vì BLANK().
	measure 'Observed Default Count — State Map' =
			COALESCE(
				CALCULATE(
					COUNTROWS('fact_evaluated_loan'),
					'fact_evaluated_loan'[target] = 1
				),
				0
			)
		formatString: #,0
		lineageTag: 7b4ddf10-5b3c-4c44-a9e0-7d0f4d09f2a1

	/// Tỷ lệ default theo bang trên cùng evaluated population của V01.
	measure 'Observed Default Rate — State Map' = DIVIDE([Observed Default Count — State Map], [Evaluated Loan Count])
		formatString: 0.00%
		lineageTag: 16e5c6c3-1b4a-4a3c-9d8e-2c7f8b6a1e04

